# Copy to .env and fill in. Never commit .env.

# Claude API key for the AI test planner. Leave empty to use the rule-based planner only.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium

# Set to 1 to start the demo app with defects D1–D3 fixed (for the retest demo later).
DEMO_FIXED=0

# Encrypts stored target-app passwords (login profiles). Required before adding a login profile.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe: if it changes, stored passwords can no longer be decrypted and must be re-entered.
DRAGONFLY_SECRET_KEY=

# Set to true when Dragonfly is served over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false
